@page "/formas-pagamento"
@rendermode InteractiveServer
@using ProjetoSalaoDeBeleza.Models
@using ProjetoSalaoDeBeleza.Services
@inject FormasPagamentoService formasPagamentoService

<div class="d-flex justify-content-between align-items-center mb-3">
    <h3 class="mb-0">Formas de Pagamento</h3>
    <button class="btn btn-primary" @onclick="AbrirModalNovo">+ Cadastrar novo</button>
</div>

@if (!string.IsNullOrEmpty(mensagemErro))
{
    <div class="alert alert-danger alert-dismissible">
        @mensagemErro
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}
@if (!string.IsNullOrEmpty(mensagemSucesso))
{
    <div class="alert alert-success alert-dismissible">
        @mensagemSucesso
        <button type="button" class="btn-close" @onclick="LimparMensagens"></button>
    </div>
}

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Cód</th>
            <th>Descrição</th>
            <th>Ativo</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var f in listaFormas)
        {
            <tr>
                <td>@f.CodFormaPagamento</td>
                <td>@f.FormaPagamento</td>
                <td>@(f.Ativo ? "Sim" : "Não")</td>
                <td>
                    <button class="btn btn-warning btn-sm" @onclick="() => AbrirModalEditar(f)">Editar</button>
                    <button class="btn btn-danger btn-sm" @onclick="() => AbrirModalExcluir(f)">Excluir</button>
                </td>
            </tr>
        }
    </tbody>
</table>

@* Modal Cadastro/Edição *@
@if (modalFormAberto)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(formaAtual.CodFormaPagamento == 0 ? "Nova Forma de Pagamento" : "Editar Forma de Pagamento")</h5>
                    <button type="button" class="btn-close" @onclick="FecharModalForm"></button>
                </div>
                <EditForm Model="@formaAtual" OnValidSubmit="Salvar" FormName="formFormasPagamento">
                    <DataAnnotationsValidator />
                    <div class="modal-body">
                        @if (!string.IsNullOrEmpty(mensagemErroModal))
                        {
                            <div class="alert alert-danger">@mensagemErroModal</div>
                        }
                        <div class="mb-3">
                            <label class="form-label">Descrição</label>
                            <InputText @bind-Value="formaAtual.FormaPagamento" class="form-control" />
                            <ValidationMessage For="@(() => formaAtual.FormaPagamento)" />
                        </div>
                        <div class="mb-3 form-check">
                            <InputCheckbox @bind-Value="formaAtual.Ativo" class="form-check-input" id="ativoCheckForma" />
                            <label class="form-check-label" for="ativoCheckForma">Ativo</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="FecharModalForm">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Salvar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
}

@* Modal Confirmação de Exclusão *@
@if (modalExcluirAberto && formaExcluir != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title">Confirmar Exclusão</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="FecharModalExcluir"></button>
                </div>
                <div class="modal-body">
                    <p class="text-danger fw-bold">Tem certeza que deseja excluir esta forma de pagamento? Esta ação não pode ser desfeita.</p>
                    <table class="table table-sm table-bordered">
                        <tbody>
                            <tr><th>Código</th><td>@formaExcluir.CodFormaPagamento</td></tr>
                            <tr><th>Descrição</th><td>@formaExcluir.FormaPagamento</td></tr>
                            <tr><th>Ativo</th><td>@(formaExcluir.Ativo ? "Sim" : "Não")</td></tr>
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="FecharModalExcluir">Cancelar</button>
                    <button type="button" class="btn btn-danger" @onclick="ConfirmarExclusao">Excluir</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<FormasPagamento> listaFormas = new();
    private FormasPagamento formaAtual = new();
    private FormasPagamento? formaExcluir;
    private bool modalFormAberto = false;
    private bool modalExcluirAberto = false;
    private string? mensagemErro;
    private string? mensagemSucesso;
    private string? mensagemErroModal;

    protected override async Task OnInitializedAsync()
    {
        await CarregarFormas();
    }

    private async Task CarregarFormas()
    {
        listaFormas = await formasPagamentoService.GetFormasPagamentoAsync();
    }

    private void AbrirModalNovo()
    {
        formaAtual = new FormasPagamento();
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void AbrirModalEditar(FormasPagamento f)
    {
        formaAtual = new FormasPagamento
        {
            CodFormaPagamento = f.CodFormaPagamento,
            FormaPagamento = f.FormaPagamento,
            Ativo = f.Ativo
        };
        mensagemErroModal = null;
        modalFormAberto = true;
    }

    private void FecharModalForm()
    {
        modalFormAberto = false;
        formaAtual = new FormasPagamento();
        mensagemErroModal = null;
    }

    private void AbrirModalExcluir(FormasPagamento f)
    {
        formaExcluir = f;
        modalExcluirAberto = true;
    }

    private void FecharModalExcluir()
    {
        modalExcluirAberto = false;
        formaExcluir = null;
    }

    private async Task Salvar()
    {
        LimparMensagens();
        try
        {
            if (formaAtual.CodFormaPagamento == 0)
                await formasPagamentoService.AddFormaPagamentoAsync(formaAtual);
            else
                await formasPagamentoService.UpdateFormaPagamentoAsync(formaAtual);

            mensagemSucesso = "Forma de pagamento salva com sucesso.";
            FecharModalForm();
            await CarregarFormas();
        }
        catch (Exception ex)
        {
            mensagemErroModal = ex.Message;
        }
    }

    private async Task ConfirmarExclusao()
    {
        if (formaExcluir == null) return;
        LimparMensagens();
        try
        {
            await formasPagamentoService.DeleteFormaPagamentoAsync(formaExcluir.CodFormaPagamento);
            mensagemSucesso = "Forma de pagamento excluída com sucesso.";
            FecharModalExcluir();
            await CarregarFormas();
        }
        catch (Exception ex)
        {
            mensagemErro = ex.Message;
            FecharModalExcluir();
        }
    }

    private void LimparMensagens()
    {
        mensagemErro = null;
        mensagemSucesso = null;
    }
}